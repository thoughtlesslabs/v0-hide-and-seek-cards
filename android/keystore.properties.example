# Copy this file to android/keystore.properties and keep the real file outside
# version control. An absolute storeFile path is recommended.
storeFile=/absolute/path/to/thoughtless-labs-upload-key.jks
storePassword=
keyAlias=
keyPassword=

# CI may omit keystore.properties and provide the equivalent environment values:
# HSC_RELEASE_STORE_FILE
# HSC_RELEASE_STORE_PASSWORD
# HSC_RELEASE_KEY_ALIAS
# HSC_RELEASE_KEY_PASSWORD
