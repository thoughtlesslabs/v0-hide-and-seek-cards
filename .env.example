# Public deployment identity. Use a DNS name whose A/AAAA record points to the VPS.
APP_DOMAIN=play.example.com
ACME_EMAIL=ops@example.com

# Generate each value independently. Use URL-safe hexadecimal for REDIS_PASSWORD
# because Compose embeds it in a redis:// URL.
#   openssl rand -hex 64   # SESSION_SIGNING_SECRET
#   openssl rand -hex 32   # REDIS_PASSWORD
# Leave these blank in the tracked template so Compose fails closed until the
# generated values are supplied in the untracked production .env file.
SESSION_SIGNING_SECRET=
REDIS_PASSWORD=

# Exact, comma-separated origins; no wildcards in production. Keep the Capacitor
# local origins for signed native builds and replace play.example.com first.
ALLOWED_ORIGINS=https://play.example.com,capacitor://localhost,https://localhost,http://localhost

# The web build uses its own origin when this is blank. Set it to the public HTTPS
# origin when producing the bundled iOS/Android assets.
VITE_GAME_SERVER_URL=

# Runtime defaults. Tune only after load testing. Socket limits bound one
# process; do not add app replicas without the distributed design in ARCHITECTURE.
GAME_REDIS_PREFIX=hide-seek:v1
GAME_SNAPSHOT_TTL_SECONDS=86400
REDIS_OPERATION_TIMEOUT_MS=2000
MATCHMAKING_WAIT_MS=8000
DISCONNECT_GRACE_MS=30000
ROOM_IDLE_TTL_MS=7200000
TICK_INTERVAL_MS=250
SNAPSHOT_RECOVERY_INTERVAL_MS=5000
MAX_SOCKET_CONNECTIONS=2000
MAX_SOCKET_CONNECTIONS_PER_USER=4
TRUST_PROXY=1
LOG_LEVEL=info
